#!/bin/sh
# Auto-generated by socrates_llmos. Runs the real secret_scanner plugin
# before every commit -- blocks the commit if it finds anything, so a
# secret being committed doesn't depend on someone remembering to run
# `llmos scan-secrets` manually first.
#
# This is a LOCAL safety net only -- .git/hooks/ is never committed to
# the repo itself (git doesn't track it), so this doesn't propagate to
# anyone else who clones the project. That's a real, known limit, not
# hidden: each clone needs this installed separately if wanted there too.

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! command -v llmos >/dev/null 2>&1; then
    echo "pre-commit: llmos not on PATH -- commit BLOCKED."
    echo "This is a security control (prevents committed secrets), not a"
    echo "convenience check, so it fails closed rather than silently letting"
    echo "the commit through. Install with:"
    echo "  pip install -e . --break-system-packages"
    echo "or bypass explicitly with 'git commit --no-verify' if truly intended."
    exit 1
fi

llmos scan-secrets
status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "pre-commit: secret scan failed -- commit blocked."
    echo "Fix the finding above, or if this is a real false positive,"
    echo "use 'git commit --no-verify' to bypass (not recommended)."
    exit 1
fi

exit 0
